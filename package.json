{
  "name": "ui_73info",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "73Info 自研 UI 组件库：令牌驱动的多主题组件，零第三方 UI 依赖",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
